# =============================================================================
# CotizaPro — Environment Variables
# =============================================================================
# Copy this file as .env.local for local development.
# For Vercel deployment, set these in Project Settings > Environment Variables.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (production)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.ohmubjcbqtijxphwnoax:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Local Development (SQLite fallback) — requires changing prisma/schema.prisma provider to "sqlite"
# DATABASE_URL="file:./dev.db"

# ── Vercel Environment ─────────────────────────────────────────────────────
# These are set automatically by Vercel:
# VERCEL=true
# VERCEL_ENV=production|preview|development
# VERCEL_URL=your-app.vercel.app

# ── How to set up in Vercel ────────────────────────────────────────────────
# 1. Go to your project in vercel.com
# 2. Settings > Environment Variables
# 3. Add: DATABASE_URL = your Supabase connection string
# 4. Redeploy for changes to take effect
