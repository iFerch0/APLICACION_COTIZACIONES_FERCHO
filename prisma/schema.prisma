datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model SellerProfile {
  id             String               @id @default(cuid())
  nombre         String
  profesion      String?
  direccion      String?
  celular        String?
  email          String?
  identificacion String?
  activo         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  documents      CommercialDocument[]
}

model Customer {
  id             String               @id @default(cuid())
  nombres        String
  apellidos      String?
  direccion      String?
  celular        String?
  email          String?
  identificacion String?
  notas          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  documents      CommercialDocument[]
}

model CommercialDocument {
  id             String                   @id @default(cuid())
  tipo           String // "COTIZACION" o "FACTURA"
  numero         String                   @unique
  fecha          DateTime                 @default(now())
  sellerId       String
  customerId     String
  observaciones  String?
  subtotal       Decimal                  @db.Decimal(12, 2)
  totalTax       Decimal                  @db.Decimal(12, 2)
  totalEnvio          Decimal             @db.Decimal(12, 2)
  totalPromocionEnvio Decimal             @db.Decimal(12, 2) @default(0)
  totalAmazon         Decimal             @db.Decimal(12, 2)
  totalImportacion    Decimal             @db.Decimal(12, 2) @default(0)
  total4x1000         Decimal             @db.Decimal(12, 2)
  totalFinal          Decimal             @db.Decimal(12, 2)
  estado              String              @default("BORRADOR")
  currency       String                   @default("COP")
  cotizacionOrigenId  String?
  margenPorcentaje    Decimal             @db.Decimal(5, 2) @default(0)
  margenTipo          String              @default("base")
  margenRedondeo      Int                 @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  seller         SellerProfile            @relation(fields: [sellerId], references: [id])
  customer       Customer                 @relation(fields: [customerId], references: [id])
  items          CommercialDocumentItem[]
  cotizacionOrigen     CommercialDocument?  @relation("CotizacionAFactura", fields: [cotizacionOrigenId], references: [id])
  facturasGeneradas    CommercialDocument[] @relation("CotizacionAFactura")
}

model CommercialDocumentItem {
  id                 String             @id @default(cuid())
  documentId         String
  orden              Int
  descripcion        String
  cantidad           Int
  precioUnitarioBase Decimal            @db.Decimal(12, 2)

  // ── Tipo y fuente de compra (Ítem Inteligente) ──
  tipoItem           String             @default("PRODUCTO")   // "PRODUCTO" | "SERVICIO"
  fuenteCompra       String             @default("LOCAL")      // "LOCAL" | "AMAZON" | "EXTERIOR_OTRO"
  precioOriginal     Decimal?           @db.Decimal(12, 4)     // Precio en moneda original (USD)
  monedaOriginal     String?            @default("COP")        // Moneda del precio original

  // ── Agrupación para PCs ensambladas ──
  grupoId            String?            // Para agrupar partes de una misma PC
  grupoLabel         String?            // Nombre del grupo (ej: "PC Gaming", "PC Oficina")

  // ── Costos ──
  aplicaTax          Boolean            @default(false)
  taxUnitario        Decimal            @db.Decimal(12, 2) @default(0)
  envioUnitario      Decimal            @db.Decimal(12, 2) @default(0)
  promocionEnvioUnitario Decimal       @db.Decimal(12, 2) @default(0)
  importacionUnitario Decimal           @db.Decimal(12, 2) @default(0)
  aplicaAmazon       Boolean            @default(false)
  amazonUnitario     Decimal            @db.Decimal(12, 2) @default(0)
  costoUnitarioFinal Decimal            @db.Decimal(12, 2)
  subtotalLinea      Decimal            @db.Decimal(12, 2)
  aplica4x1000       Boolean            @default(false)
  valor4x1000Linea   Decimal            @db.Decimal(12, 2) @default(0)
  document           CommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id          String   @id @default(cuid())
  clave       String   @unique
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt
}

model DocumentSequence {
  id        String   @id @default(cuid())
  tipo      String   @unique // "COTIZACION" o "FACTURA"
  anio      Int
  secuencia Int      @default(0)
  updatedAt DateTime @updatedAt
}
